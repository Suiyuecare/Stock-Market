POSTGRES_DB=stock_prediction
POSTGRES_USER=stock_app
POSTGRES_PASSWORD=stock_app_password
DATABASE_URL=postgresql+psycopg://stock_app:stock_app_password@postgres:5432/stock_prediction
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=
LLM_PROVIDER=openai
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=https://stock.suiyuecare.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
CRON_SECRET=

# Provider authorization. Keep real keys in local/Vercel env vars only.
ENABLE_KEYED_MARKET_DATA=false
ENABLE_OPENAI_NEWS_PARSER=false
ENABLE_COMMERCIAL_DATA_PROVIDERS=false
FINNHUB_API_KEY=
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
NASDAQ_DATA_LINK_API_KEY=
EODHD_API_KEY=
TWELVE_DATA_API_KEY=
NEWSAPI_KEY=
NEWS_RSS_URLS=
TEJ_API_KEY=

# Free/public analyst target price ingestion.
# Runs from Vercel Cron every 2 days and writes public-news extracted targets to Supabase.
TARGET_PRICE_NEWS_RSS_URLS=
TARGET_PRICE_NEWS_ARTICLE_URLS=
TARGET_PRICE_NEWS_MAX_ARTICLES=40
TARGET_PRICE_FETCH_ALL_ARTICLES=false

# External analyst target price / estimate providers.
# FMP is the lightweight keyed source currently wired for direct fetch.
# FactSet, LSEG I/B/E/S, and Bloomberg usually require contract-specific
# endpoint, field, and redistribution-right mapping before display.
FMP_API_KEY=
FINANCIAL_MODELING_PREP_API_KEY=
FACTSET_API_KEY=
LSEG_API_KEY=
BLOOMBERG_API_KEY=
SEC_EDGAR_USER_AGENT=

FCM_SERVICE_ACCOUNT_JSON=
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
AUTH0_MANAGEMENT_API_TOKEN=
CLERK_SECRET_KEY=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
